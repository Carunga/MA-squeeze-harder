From b1fd7e7bafa897edd1dbe4d08cf197f79bec63a4 Mon Sep 17 00:00:00 2001
From: seb <sebastian.merz@web.de>
Date: Sat, 19 Sep 2026 22:15:07 +0200
Subject: [PATCH 3/3] Point the aioslimproto requirement at the patched fork

Use the documented git+ requirement so the provider pulls the patched
aioslimproto (with the new sync module). The loader installs requirements
that are not version-pinned when the provider import fails, which is the
case here because the provider imports aioslimproto.sync.
---
 music_assistant/providers/squeezelite/manifest.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/music_assistant/providers/squeezelite/manifest.json b/music_assistant/providers/squeezelite/manifest.json
index 51f246a0e..49839f2fb 100644
--- a/music_assistant/providers/squeezelite/manifest.json
+++ b/music_assistant/providers/squeezelite/manifest.json
@@ -8,7 +8,7 @@
   "credits": [
     "[aioslimproto](https://github.com/music-assistant/aioslimproto)"
   ],
-  "requirements": ["aioslimproto==3.2.2"],
+  "requirements": ["aioslimproto @ git+https://github.com/Carunga/aioslimproto@d5bbf9601fcd965d438049941f48670e338a4de0"],
   "documentation": "https://music-assistant.io/player-support/squeezelite/",
   "multi_instance": false,
   "builtin": false
-- 
2.42.0

